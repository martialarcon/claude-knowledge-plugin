{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/schemas/skill-rules.schema.json",
  "version": "1.0",
  "name": "{{PROJECT_NAME}}-skill-rules",
  "description": "Reglas de auto-activación para Knowledge Agent y Planner",

  "activation": {
    "global_settings": {
      "enabled": true,
      "log_activations": true,
      "learning_enabled": true,
      "min_confidence_score": 0.6
    },

    "skills": [
      {
        "id": "knowledge-agent",
        "skill_path": ".claude/skills/knowledge-agent/SKILL.md",
        "priority": 100,
        "enabled": true,

        "triggers": {
          "commands": [
            "/{{PROJECT_SLUG}}",
            "/{{PROJECT_SLUG}} analyze",
            "/{{PROJECT_SLUG}} query",
            "/{{PROJECT_SLUG}} trace",
            "/{{PROJECT_SLUG}} impact",
            "/{{PROJECT_SLUG}} diagnose",
            "/{{PROJECT_SLUG}} update",
            "/{{PROJECT_SLUG}} capture",
            "/{{PROJECT_SLUG}} commands",
            "/{{PROJECT_SLUG}} help",
            "/{{PROJECT_SLUG}} diagram",
            "/{{PROJECT_SLUG}} status",
            "/{{PROJECT_SLUG}} env",
            "/{{PROJECT_SLUG}} branches",
            "/{{PROJECT_SLUG}} handoff"
          ],

          "patterns": [
            {
              "regex": "^/{{PROJECT_SLUG}}\\s+",
              "score": 1.0,
              "description": "Comando directo /{{PROJECT_SLUG}}"
            },
            {
              "keywords": ["analiza", "viabilidad", "es posible", "se puede", "puedo"],
              "score": 0.85,
              "description": "Análisis de viabilidad"
            },
            {
              "keywords": ["dónde se usa", "quién consume", "cómo funciona", "cómo está implementado"],
              "score": 0.9,
              "description": "Consultas de arquitectura"
            },
            {
              "keywords": ["qué impacto", "a quién afecta", "qué módulos"],
              "score": 0.85,
              "description": "Análisis de impacto"
            },
            {
              "keywords": ["inconsistencia", "problema conocido", "deuda técnica"],
              "score": 0.8,
              "description": "Issues conocidos"
            },
            {
              "keywords": ["entorno", "dev", "uat", "producción", "staging", "prod"],
              "score": 0.7,
              "description": "Contexto de entornos"
            },
            {
              "keywords": ["branch", "rama", "desplegado", "deploy"],
              "score": 0.7,
              "description": "Trazabilidad de branches"
            },
            {
              "keywords": ["diagrama", "flujo", "arquitectura", "módulo"],
              "score": 0.75,
              "description": "Generación de diagramas"
            },
            {
              "keywords": ["no funciona", "falla", "error", "bug", "problema"],
              "score": 0.8,
              "description": "Debugging"
            },
            {
              "keywords": ["guarda lo aprendido", "captura conocimiento", "salva el contexto", "persiste lo aprendido"],
              "score": 0.9,
              "description": "Captura de conocimiento de sesión a KB"
            }
          ],

          "file_patterns": [
            { "glob": "**/L0-system/**",   "score": 0.9  },
            { "glob": "**/L1-modules/**",  "score": 0.85 },
            { "glob": "**/L2-domain/**",   "score": 0.9  },
            { "glob": "**/handoff/**",     "score": 0.95 },
            { "glob": "**/environments.yaml", "score": 0.9 }
          ]
        },

        "hooks": {
          "pre_activation": ".claude/hooks/pre-activate.sh",
          "post_activation": ".claude/hooks/post-activate.sh",
          "on_success": ".claude/hooks/on-success.sh"
        },

        "context_injection": {
          "always_include": [
            "L0-system/environments.yaml"
          ],
          "on_debugging": [
            "L5-issues/INDEX-open.md"
          ],
          "on_analysis": [
            "index/keywords.json"
          ]
        },

        "exclusions": {
          "patterns": [
            "implementa",
            "escribe código",
            "crea el archivo",
            "genera tests"
          ],
          "commands": [
            "/planner",
            "/dev",
            "/test"
          ]
        }
      },

      {
        "id": "planner",
        "skill_path": ".claude/skills/planner/SKILL.md",
        "priority": 90,
        "enabled": true,

        "triggers": {
          "commands": [
            "/planner",
            "/planner-status",
            "/planner-review"
          ],

          "patterns": [
            {
              "regex": "^/planner\\s+",
              "score": 1.0,
              "description": "Comando directo /planner"
            },
            {
              "keywords": ["planifica", "plan de implementación", "cómo implementar"],
              "requires_handoff": true,
              "score": 0.85,
              "description": "Planificación de implementación"
            },
            {
              "keywords": ["estimación", "esfuerzo", "días de trabajo"],
              "score": 0.7,
              "description": "Estimaciones"
            },
            {
              "keywords": ["orden de implementación", "secuencia", "prioridad módulos"],
              "score": 0.8,
              "description": "Secuenciación"
            }
          ],

          "file_patterns": [
            { "glob": "**/handoff/*.yaml", "score": 0.95 },
            { "glob": "**/plans/**",       "score": 0.9  }
          ],

          "preconditions": [
            {
              "type": "file_exists",
              "pattern": "handoff/{id}.yaml",
              "on_missing": {
                "action": "redirect_to_skill",
                "skill": "knowledge-agent",
                "message": "Primero ejecuta: /{{PROJECT_SLUG}} handoff {id} \"descripción\""
              }
            }
          ]
        },

        "tool_permissions": {
          "allowed": ["Read", "Bash", "Grep", "Glob", "LS", "WebFetch"],
          "denied": ["Write", "Edit"]
        }
      }
    ]
  },

  "fallback": {
    "no_match": {
      "action": "ask_user",
      "message": "¿Qué agente debería usar para esta tarea?",
      "options": ["knowledge-agent", "planner", "ninguno"]
    },
    "low_confidence": {
      "threshold": 0.6,
      "action": "suggest_with_confirmation",
      "message": "Parece que necesitas {skill}. ¿Confirmo?"
    }
  }
}
