{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "jq -e '.tool_input.skill | test(\"knowledge-agent|planner\")' 2>/dev/null && bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-activate.sh\" || true",
            "timeout": 60,
            "statusMessage": "Actualizando repositorios..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/on-user-prompt.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "jq -e '.tool_input.skill | test(\"knowledge-agent|planner\")' 2>/dev/null && bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-activate.sh\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/on-session-end.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
